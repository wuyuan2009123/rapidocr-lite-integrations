<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.rapidocr</groupId>
    <artifactId>rapidocr-lite-integrations</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>rapidocr-lite-integrations</name>
    <description>RapidOCRLite 的 Spring Boot 4 Starter 与 Solon 插件</description>

    <modules>
        <module>rapidocr-lite-spring-boot-starter</module>
        <module>rapidocr-lite-solon-plugin</module>
        <module>demo-springboot4</module>
        <module>demo-solon</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <spring-boot.version>4.1.2</spring-boot.version>
        <solon.version>4.1.1</solon.version>
        <rapidocrlite.version>5.0.0a15</rapidocrlite.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 官方 Java 绑定（内含 win/linux/macos 各平台 JNI 与引擎原生库）。
                 该包未发布到中央仓库，首次构建前执行 scripts/install-deps.ps1
                 （或 .sh）把它安装到本地仓库，见 README。 -->
            <dependency>
                <groupId>ai.rapidocr</groupId>
                <artifactId>rapidocrlite-java</artifactId>
                <version>${rapidocrlite.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.rapidocr</groupId>
                <artifactId>rapidocr-lite-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.rapidocr</groupId>
                <artifactId>rapidocr-lite-solon-plugin</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
